        <dependency id="Hexa.NET.ImPlot" version="2.2.8.4" exclude="Build,Analyzers" />
        <dependency id="OpenTK.GLControl" version="3.1.0" exclude="Build,Analyzers" />
        <dependency id="System.Collections.Immutable" version="8.0.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>